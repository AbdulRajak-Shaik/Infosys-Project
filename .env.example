# ==============================================================================
# AgroAI - Environment Configuration Example Template
# Duplicate this file to `.env` and provide your actual API keys and secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# SQLite (default for local development):
DATABASE_URL=sqlite:///./soil_health.db

# PostgreSQL (for production / Render deployments):
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# ------------------------------------------------------------------------------
# 2. SECURITY & JWT AUTHENTICATION
# ------------------------------------------------------------------------------
# Generate strong 256-bit random keys in production (e.g. using `openssl rand -hex 32`)
JWT_SECRET_KEY=replace_with_a_secure_random_secret_key_for_access_tokens
JWT_REFRESH_SECRET_KEY=replace_with_a_secure_random_secret_key_for_refresh_tokens
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# 3. SARVAM AI (MULTILINGUAL LOCALIZATION & TTS)
# ------------------------------------------------------------------------------
# Get your API key from: https://www.sarvam.ai/
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_API_URL=https://api.sarvam.ai

# ------------------------------------------------------------------------------
# 4. GOOGLE GEMINI AI (AGRI-CHATBOT & ADVANCED RECOMMENDATIONS)
# ------------------------------------------------------------------------------
# Get your API key from: https://aistudio.google.com/
GEMINI_API_KEY_1=your_gemini_api_key_here
GEMINI_API_KEY_2=optional_backup_gemini_key
GEMINI_API_KEY_3=optional_backup_gemini_key

# ------------------------------------------------------------------------------
# 5. OPENWEATHERMAP API (HYPER-LOCAL WEATHER INTELLIGENCE)
# ------------------------------------------------------------------------------
# Get your free API key from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# ------------------------------------------------------------------------------
# 6. ASYNC TASK QUEUE (CELERY & REDIS - OPTIONAL)
# ------------------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 7. SMTP EMAIL NOTIFICATIONS (OPTIONAL)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_email_app_password
SMTP_FROM=AgroAI Support <noreply@agroai.com>

# ------------------------------------------------------------------------------
# 8. FRONTEND CLIENT API BASE URL (OPTIONAL)
# ------------------------------------------------------------------------------
# Leave blank when deployed as a unified single-service fullstack app on Render.
# For standalone frontend dev server:
VITE_API_BASE_URL=http://localhost:8000
